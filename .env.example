# MySQL 连接（外部实例，必填）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=relay
DB_PASSWORD=
DB_NAME=relay_monitor

# Cloudflare Turnstile 登录人机验证（可选，两项都填才启用；组件主机名须为域名，不支持 IP）
# 本地联调可用官方测试密钥：site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# v1 数据一次性迁移来源（可选）：指向 v1 的 data 目录，表为空时自动导入
V1_DATA_DIR=./data
